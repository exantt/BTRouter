# Copy this file to `keystore.properties` (which is git-ignored) for local signed release builds.
# NEVER commit `keystore.properties` or any `.jks` / `.keystore` file to version control!
#
# Relative paths in `storeFile` are resolved relative to the directory containing `keystore.properties`
# (i.e. the repository root if placed at `BTRouter/keystore.properties`).
storeFile=../btrouter-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=btrouter
keyPassword=CHANGE_ME_KEY_PASSWORD
