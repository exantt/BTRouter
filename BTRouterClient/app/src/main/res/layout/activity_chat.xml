<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ ЧАТА -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btnChatBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#2C2C2E"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="@string/btn_back"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Дом" />

            <TextView
                android:id="@+id/tvChatHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9AA0A6"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="+7 999 000 00 00"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChatArchivedTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_new"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/chat_archived_label"
            android:textColor="#8AB4F8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E" />

    <!-- СПИСОК СООБЩЕНИЙ + ПЛАВАЮЩАЯ КНОПКА ПРОЛИСТАТЬ И ПРОЧИТАТЬ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp" />

        <LinearLayout
            android:id="@+id/btnMarkAllReadScroll"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill_blue"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvMarkAllReadText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Mark all read (5)" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/chat_scroll_bottom_cd"
                android:src="@drawable/ic_arrow_down"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- СТРОКА НАБОРА СООБЩЕНИЯ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E" />

    <TextView
        android:id="@+id/tvRepliesUnsupported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#18181A"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="@string/chat_replies_unsupported"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161618"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_composer_input"
            android:hint="@string/chat_input_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minHeight="42dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:scrollbars="vertical"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSendMessage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="#2196F3"
            android:contentDescription="@string/chat_send_cd"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            app:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
