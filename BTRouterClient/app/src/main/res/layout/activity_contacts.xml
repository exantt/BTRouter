<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contactsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btnContactsBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#2C2C2E"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="@string/btn_back"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/contacts_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReloadContacts"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#2C2C2E"
            android:minWidth="38dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="🔄"
            android:textColor="#4CAF50"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ПЕРЕКЛЮЧАТЕЛЬ ИСТОЧНИКА CLIENT / SERVER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            android:orientation="horizontal"
            android:padding="3dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnSourceClient"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#2196F3"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="@string/source_client"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSourceServer"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#1C1C1E"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="@string/source_server"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- СТРОКА ДИНАМИЧЕСКОГО ПОИСКА -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/etSearchContacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#2196F3"
            android:hint="@string/contacts_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnClearSearch"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#2C2C2E"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E" />

    <!-- ИНФОРМАЦИОННЫЙ БАННЕР / ЗАГРУЗКА / ПРАВА -->
    <LinearLayout
        android:id="@+id/layoutContactsBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvContactsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB74D"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnContactsBannerAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2C2C2E"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- СПИСОК КОНТАКТОВ -->
    <ListView
        android:id="@+id/lvContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent" />

    <TextView
        android:id="@+id/tvEmptyContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
