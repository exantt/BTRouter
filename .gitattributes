* text=auto

# Keep shell scripts and Gradle wrappers with LF so Linux CI runners execute them cleanly
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Source, config, and documentation files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.toml text eol=lf
*.json text eol=lf
LICENSE text eol=lf

# Binary assets
*.jar binary
*.webp binary
*.png binary
*.jpg binary
*.ico binary
